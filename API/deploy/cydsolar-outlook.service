[Unit]
Description=Generate outlook.json from Open-Meteo
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Adjust User/Group to whoever owns /var/www/dashboard-solar (or wherever
# Caddy's site root actually is) so the written file is Caddy-readable.
User=cydsolar
Group=cydsolar
# Provides LATITUDE/LONGITUDE -- not versioned, created once on the VPS
# (see API/deploy/README.md). Deploy only ever overwrites this unit file,
# never this env file, so the real coordinates never pass through the repo.
EnvironmentFile=/etc/cydsolar/coords.env
ExecStart=/opt/cydsolar-api/cydsolar-api -out /var/www/dashboard-solar/outlook.json -history /var/lib/cydsolar/forecast-history.ndjson -lat ${LATITUDE} -lon ${LONGITUDE}
