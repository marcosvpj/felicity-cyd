#pragma once

// Copy this file to secrets.h (gitignored) and fill in your real values.
#define SECRET_WIFI_SSID "your-wifi-ssid"
#define SECRET_WIFI_PSK  "your-wifi-password"
#define SECRET_HOST      "192.168.1.100"   // dongle's LAN IP

// Forecast endpoint. Point this at your own outlook service — running
// without one is fine too, the display just falls back to its degraded
// no-forecast state.
#define SECRET_OUTLOOK_URL "https://your-outlook-host.example/outlook.json"

// Nameplate capacity of your battery pack, in Ah.
#define SECRET_BATTERY_CAPACITY_AH 100.0f

// UTC offset for your timezone, in seconds (e.g. BRT = UTC-3 = -3*3600).
#define SECRET_UTC_OFFSET_SEC (-3 * 3600)

// Gates over-the-air firmware updates (see platformio.ini's `cyd_ota` env).
// Anyone on the LAN who knows this can push firmware to the device, so pick
// something other than the WiFi password.
#define SECRET_OTA_PASSWORD "change-me"
